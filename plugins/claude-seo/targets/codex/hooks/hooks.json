{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-python-hook.js",
              "${CLAUDE_PLUGIN_ROOT}/hooks/validate-schema.py",
              "${tool_input.file_path}"
            ],
            "command": "node",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  }
}
