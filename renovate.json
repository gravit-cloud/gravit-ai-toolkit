{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update plugin tags and immutable commit pins in the neutral registry catalog",
      "managerFilePatterns": [
        "/^registry\\/catalog\\.json$/"
      ],
      "matchStrings": [
        "\"source\"\\s*:\\s*\\{\\s*\"type\"\\s*:\\s*\"github\",\\s*\"repo\"\\s*:\\s*\"(?<packageName>[^\"]+)\",\\s*\"ref\"\\s*:\\s*\"(?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?)\",\\s*\"sha\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update immutable commit pins for catalog plugins following a branch",
      "managerFilePatterns": [
        "/^registry\\/catalog\\.json$/"
      ],
      "matchStrings": [
        "\"source\"\\s*:\\s*\\{\\s*\"type\"\\s*:\\s*\"github\",\\s*\"repo\"\\s*:\\s*\"(?<packageName>[^\"]+)\",\\s*\"ref\"\\s*:\\s*\"(?<currentValue>main|master)\",\\s*\"sha\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "github-digest"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "registry/catalog.json"
      ],
      "addLabels": [
        "marketplace"
      ],
      "commitMessageTopic": "registry plugin {{depName}}"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "ci"
      ]
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bash scripts/renovate-plugin-sync.sh"
    ],
    "fileFilters": [
      "registry/catalog.json",
      "registry/lock.json",
      ".claude-plugin/marketplace.json",
      ".agents/**",
      "plugins/**"
    ],
    "executionMode": "branch",
    "installTools": {
      "node": {}
    }
  }
}
