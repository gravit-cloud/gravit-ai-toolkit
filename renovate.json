{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update plugin tags and immutable commit pins in the neutral registry catalog",
      "managerFilePatterns": [
        "/^registry\\/catalog\\.json$/"
      ],
      "matchStrings": [
        "\"source\"\\s*:\\s*\\{\\s*\"type\"\\s*:\\s*\"github\",\\s*\"repo\"\\s*:\\s*\"(?<packageName>[^\"]+)\",\\s*\"ref\"\\s*:\\s*\"(?<currentValue>v?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)\",\\s*\"sha\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{40})\"(?:,\\s*\"root\"\\s*:\\s*\"[^\"\\r\\n]+\")?\\s*\\}",
        "\"source\"\\s*:\\s*\\{\\s*\"ref\"\\s*:\\s*\"(?<currentValue>v?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)\",\\s*\"repo\"\\s*:\\s*\"(?<packageName>[^\"]+)\",\\s*(?:\"root\"\\s*:\\s*\"[^\"\\r\\n]+\",\\s*)?\"sha\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{40})\",\\s*\"type\"\\s*:\\s*\"github\"\\s*\\}"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update immutable commit pins for catalog plugins following a branch",
      "managerFilePatterns": [
        "/^registry\\/catalog\\.json$/"
      ],
      "matchStrings": [
        "\"source\"\\s*:\\s*\\{\\s*\"type\"\\s*:\\s*\"github\",\\s*\"repo\"\\s*:\\s*\"(?<packageName>[^\"]+)\",\\s*\"ref\"\\s*:\\s*\"(?<currentValue>main|master)\",\\s*\"sha\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{40})\"(?:,\\s*\"root\"\\s*:\\s*\"[^\"\\r\\n]+\")?\\s*\\}",
        "\"source\"\\s*:\\s*\\{\\s*\"ref\"\\s*:\\s*\"(?<currentValue>main|master)\",\\s*\"repo\"\\s*:\\s*\"(?<packageName>[^\"]+)\",\\s*(?:\"root\"\\s*:\\s*\"[^\"\\r\\n]+\",\\s*)?\"sha\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{40})\",\\s*\"type\"\\s*:\\s*\"github\"\\s*\\}"
      ],
      "datasourceTemplate": "github-digest"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "registry/catalog.json"
      ],
      "addLabels": [
        "marketplace"
      ],
      "commitMessageTopic": "registry plugin {{depName}}"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "ci"
      ]
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bash scripts/renovate-plugin-sync.sh"
    ],
    "fileFilters": [
      "registry/catalog.json",
      "registry/lock.json",
      ".claude-plugin/marketplace.json",
      ".agents/**",
      "plugins/**"
    ],
    "executionMode": "branch",
    "installTools": {
      "node": {}
    }
  }
}
